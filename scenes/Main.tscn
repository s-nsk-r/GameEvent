[node name="Whisper1" parent="." instance=ExtResource("7_whisper")]
position = Vector2(460, 410)
whisper_title = "WHISPER I: THE ECLIPSE RIFT"
whisper_text = "Look ahead across the chasm. The ghost crimson mushrooms exist in the shadow plane.\nJump into the air with SPACE, and press Z mid-flight.\nWatch the shadow solidify beneath your feet."

[node name="Whisper2" parent="." instance=ExtResource("7_whisper")]
position = Vector2(1850, 410)
whisper_title = "WHISPER II: THE TWIN REALMS"
whisper_text = "Two astronomers pointed their telescopes into the dark.\nOne saw a dying star; the other saw a newborn sun.\nTogether, their light forms the pulse of Continuum-9."

[node name="Whisper3" parent="." instance=ExtResource("7_whisper")]
